<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background_dark">#0D0D0D</color>
    <color name="primary_orange">#FF6600</color>
    <color name="accent_gold">#FFD700</color>
    
    <style name="Theme.VolumeMaxApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorPrimary">@color/primary_orange</item>
        <item name="android:colorPrimaryDark">#CC5200</item>
        <item name="android:colorAccent">@color/accent_gold</item>
    </style>
</resources>
